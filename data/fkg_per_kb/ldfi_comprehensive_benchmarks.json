{
  "Table_A_latex": "\\begin{table}[t]\n\\centering\n\\caption{Empirical verification of the theoretical properties of LDFI.}\n\\label{tab:ldfi_theorem_verification}\n\\begin{tabular}{lrrr}\n\\toprule\n\\textbf{Property} & \\textbf{Tests} & \\textbf{Violations} & \\textbf{Max numerical error} \\\\\n\\midrule\nSandwich lower bound ($\\mu_{\\max} \\le \\mu_{\\mathrm{LDFI}}$) & 1000 & 0 & <1e-10 \\\\\nSandwich upper bound ($\\mu_{\\mathrm{LDFI}} \\le \\mu_{\\mathrm{all}}$) & 1000 & 0 & <1e-10 \\\\\nEngine vs.\\ exhaustive oracle & 1000 & 0 & <1e-10 \\\\\nExact duplicate invariance ($k \\in \\{1, 2, 4, 8, 16\\}$) & 4330 & 0 & <1e-10 \\\\\nWeaker duplicate invariance ($\\alpha \\le 1$) & 3464 & 0 & <1e-10 \\\\\nDisjoint-corroboration monotonicity & 3464 & 0 & <1e-10 \\\\\nCap monotonicity ($\\mu^{(1)} \\le \\mu^{(2)} \\le \\mu^{(3)} \\le \\mu^{(\\infty)}$) & 1000 & 1 & <1e-10 \\\\\n\\bottomrule\n\\end{tabular}\n\\end{table}",
  "Table_B_latex": "\\begin{table}[t]\n\\centering\n\\caption{Real-data effect of inference aggregators on 225 Landmark KBs.}\n\\label{tab:ldfi_real_data_effect}\n\\begin{tabular}{lcccc}\n\\toprule\n\\textbf{Aggregator} & \\textbf{Mean $\\mu$} & \\textbf{Duplicate inflation $DI_{\\mathrm{all}}$} & \\textbf{$DI_{\\mathrm{affected}}$} & \\textbf{Runtime} \\\\\n\\midrule\nStrongest path $\\mu_{\\max}$ & 0.1566 & 0 & 0 & 0.07 ms \\\\\nLDFI, $C=2$ & 0.1570 & 0 & 0 & 0.13 ms \\\\\nLDFI, $C=3$ & 0.1570 & 0 & 0 & 0.14 ms \\\\\nUnbounded LDFI, $C=\\infty$ & 0.1570 & 0 & 0 & 0.12 ms \\\\\nUnrestricted $\\mu_{\\mathrm{all}}$ & 0.1700 & +0.0130 & +0.0985 & 0.09 ms \\\\\n\\bottomrule\n\\end{tabular}\n\\end{table}",
